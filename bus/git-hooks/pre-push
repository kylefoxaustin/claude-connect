#!/usr/bin/env bash
# Global `pre-push` git hook — the REAL enforcer behind Kyle's one-click push OK.
#
# WHY THIS EXISTS (the hole it closes): the PreToolUse(Bash) gate (`push-gate.sh`) only greps the
# Bash tool-call STRING for "push". So a `git push` that isn't literally in that string — a script
# (`./snapshot.sh`), `bash -c 'git push'`, a `make deploy` target, or a git alias — sails straight
# through (exit 0, gate never engages). A pre-push hook fires on the REAL push regardless of how it
# was invoked, and git hands it the actual refs + shas + remote on stdin, so it can SHA-pin exactly
# and tell a true no-op from a real ref move. It is strictly stronger than the tool-layer gate for
# the honest-but-scripted case. (Only `git push --no-verify` skips a pre-push hook — a deliberate
# bypass, outside this threat model, and it still needs an existing approval to be worth anything.)
#
# COORDINATION WITH THE PreToolUse GATE (so we don't double-deny an approved DIRECT push):
#   • Direct `git push` with a valid token: PreToolUse consumes the token AND drops a short-lived
#     CLAIM (push-claims/<key>). This hook then fires, finds no token but a fresh matching claim,
#     honours it once, and deletes it.
#   • Scripted push: PreToolUse never engaged, so there is NO claim → this hook enforces from the
#     token alone (consume-on-approve, else DENY + file a request). That is the bypass, closed.
#
# Args:  $1 = remote name, $2 = remote URL.   Stdin: `<localref> <localsha> <remoteref> <remotesha>`
# per ref being pushed (localsha all-zeros = a delete; a real push, still gated).
set -uo pipefail

COORD="${COORD_STATE_DIR:-$HOME/.claude/bus-state/coord}"
TOKENS="$COORD/push-tokens"
REQUESTS="$COORD/push-requests"
CLAIMS="$COORD/push-claims"
CLAIM_TTL="${PUSH_CLAIM_TTL:-120}"          # a claim older than this can never authorize a push
ZERO='0000000000000000000000000000000000000000'

REMOTE_NAME="${1:-origin}"
REMOTE_URL="${2:-}"

# Buffer stdin once — we both inspect it and (if chaining) replay it to the repo's own hook.
STDIN="$(cat 2>/dev/null || true)"

# ---- 1. Chain to a REPO-LOCAL pre-push hook first, if one exists -------------------------------
# Setting core.hooksPath globally makes git stop looking in <gitdir>/hooks, so a repo that ships
# its own pre-push (e.g. nanochat_rtx8000) would be silently disabled. Preserve it: run it first
# with the same stdin+args; if it rejects (non-zero), so do we — never weaken a repo's own policy.
GITDIR="$(git rev-parse --git-dir 2>/dev/null || true)"
if [ -n "$GITDIR" ] && [ -x "$GITDIR/hooks/pre-push" ]; then
  printf '%s' "$STDIN" | "$GITDIR/hooks/pre-push" "$@" || exit $?
fi

# ---- 2. Is anything actually MOVING? (a no-op push never needs approval) -----------------------
# Collect the local shas that would become new remote tips (local != remote, local not all-zero).
# All-zero local = a branch delete: that IS a real, gated push, so record a sentinel for it.
MOVING=""; DELETING=0
while read -r lref lsha rref rsha; do
  [ -z "${lref:-}" ] && continue
  if [ "$lsha" = "$ZERO" ]; then DELETING=1; continue; fi   # delete of rref
  [ "$lsha" = "$rsha" ] && continue                          # this ref is up-to-date
  MOVING="$MOVING $lsha"
done <<EOF
$STDIN
EOF
# Nothing moves and nothing is deleted → genuine no-op → allow, consume nothing.
if [ -z "$MOVING" ] && [ "$DELETING" = 0 ]; then exit 0; fi

# ---- 3. Identify the repo + its token key (same scheme as push-gate.sh) ------------------------
REPO="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
NAME="$(basename "$REPO")"
KEY="$(printf '%s' "$REPO" | tr '/ ' '__' | sed 's/^_*//')"
now="$(date +%s)"

# ---- 4. Exemption: the private disaster-recovery backup repo auto-pushes ------------------------
# Same policy + spoof-resistance as push-gate.sh: match the REMOTE SLUG, not the dir name. Here we
# match against the URL git itself is pushing to ($2) — authoritative, not reconstructed.
FLEET_BACKUP_SLUG="${FLEET_BACKUP_SLUG:-kylefoxaustin/fleet-backup}"
_slug="$(printf '%s' "$REMOTE_URL" | sed -E 's#^(https?://[^/]+/|ssh://[^/]+/|[^/@]+@[^:]+:)##; s#\.git$##; s#/+$##')"
if [ -z "$_slug" ]; then   # some invocations pass only the remote NAME as url; resolve it
  _u="$(git remote get-url "$REMOTE_NAME" 2>/dev/null || true)"
  _slug="$(printf '%s' "$_u" | sed -E 's#^(https?://[^/]+/|ssh://[^/]+/|[^/@]+@[^:]+:)##; s#\.git$##; s#/+$##')"
fi
if [ -n "$_slug" ] && [ "$_slug" = "$FLEET_BACKUP_SLUG" ]; then
  rm -f "$REQUESTS/$KEY" 2>/dev/null || true
  exit 0
fi

# ---- 4b. Exemption: msgbox-only pushes on the Finding Together repo -----------------------------
# Kyle's policy (2026-08-22): msgbox/ is the channel three separate Claude sessions talk on. A
# reply that needs a human tap puts a person in the middle of every sentence, so message traffic
# is auto-allowed while CODE still needs approval. Scope decided explicitly: msgbox/ ONLY.
#
# This hook is the better place to enforce it than push-gate.sh, because git hands us the ACTUAL
# refs on stdin — old sha and new sha per ref. We do not have to guess from the command line what
# is being pushed; we can diff exactly what would land.
#
# FAILS CLOSED at every step. A branch delete, a brand-new branch (no base to diff against), a
# non-fast-forward, a git error, or an empty file list all fall through to the normal gate. The
# ONLY path to exit 0 is: every moving ref is a fast-forward whose every changed file is under
# msgbox/.
FT_SLUG="${FT_SLUG:-FindingTogether/findingtogether}"
if [ -n "$_slug" ] && [ "$_slug" = "$FT_SLUG" ] && [ "$DELETING" = 0 ]; then
  _mb_ok=1; _mb_any=0
  while read -r lref lsha rref rsha; do
    [ -z "${lref:-}" ] && continue
    [ "$lsha" = "$rsha" ] && continue
    if [ "$rsha" = "$ZERO" ]; then _mb_ok=0; break; fi          # new branch: nothing to diff from
    git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null || { _mb_ok=0; break; }
    _mb_files="$(git diff --name-only "$rsha" "$lsha" 2>/dev/null)" || { _mb_ok=0; break; }
    [ -n "$_mb_files" ] || { _mb_ok=0; break; }                 # empty diff -> not provably msgbox
    if printf '%s\n' "$_mb_files" | grep -qv '^msgbox/'; then _mb_ok=0; break; fi
    _mb_any=1
  done <<MBEOF
$STDIN
MBEOF
  if [ "$_mb_ok" = 1 ] && [ "$_mb_any" = 1 ]; then
    rm -f "$REQUESTS/$KEY" 2>/dev/null || true
    exit 0                                                       # ALLOW — msgbox traffic only
  fi
fi

# ---- 4c. WILL THE REMOTE EVEN TAKE THIS? Refuse WITHOUT consuming if not. ----------------------
# ⚠️ THE TOKEN IS CONSUMED HERE, AT AUTHORISATION TIME — which is BEFORE git has spoken to the
# remote. So a push the remote then rejects as non-fast-forward has already burned Kyle's approval,
# and he taps again for a push that never existed. Measured 2026-08-26/27: 18 approvals granted in
# two days, several of them spent on races with a second contributor pushing to the same branch.
#
# git hands us `<localref> <localsha> <remoteref> <remotesha>` on stdin and we already read it to
# spot no-ops. If the remote tip is NOT an ancestor of ours, the push CANNOT land — so say so and
# leave the grant alone. Predicting the rejection costs one merge-base call and saves a tap.
#
# Unknown remote sha (we have not fetched it) => we cannot predict, so we do not: fall through and
# behave exactly as before. Being wrong here must never be worse than today's behaviour.
NEEDS_REBASE=""
while read -r lref lsha rref rsha <&9; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$ZERO" ] && continue                 # a delete: not a fast-forward question
  [ -z "$rsha" ] && continue
  [ "$rsha" = "$ZERO" ] && continue                 # brand-new remote branch: trivially fine
  [ "$lsha" = "$rsha" ] && continue                 # already up to date
  # ⚠️ THE REMOTE TIP IS NORMALLY *NOT* A LOCAL OBJECT, and that is the whole case this guard
  # exists for: you learn the remote moved by being rejected, which is after the fetch you have
  # not done. My first version simply skipped when the object was missing — so it took a branch
  # production never reaches, and burned Kyle's approval on the very race it was written to stop.
  # ⭐ AND MY TEST HID IT: the fixture fetched before invoking the hook, making the object local,
  # so the suite exercised the easy branch and went green. A test that establishes the one
  # precondition production lacks is a mirror.
  # We are about to talk to the remote anyway, so fetching one ref costs nothing we were not
  # already paying. If it still cannot be resolved, fall through unchanged — no prediction.
  if ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    git fetch -q "$REMOTE_NAME" "$rref" 2>/dev/null || true
    git cat-file -e "$rsha^{commit}" 2>/dev/null || continue
  fi
  if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    NEEDS_REBASE="$rref"
  fi
done 9<<EOF
$STDIN
EOF
if [ -n "$NEEDS_REBASE" ]; then
  cat >&2 <<EOF
⏪ Not pushing: $NEEDS_REBASE has moved since you last fetched, so this push would be REJECTED.

   YOUR APPROVAL IS UNTOUCHED — it has not been spent on a push that cannot land.
   Rebase and push again:   git pull --rebase origin <branch>

   (If the rebase changes any commit's CONTENT, the approval stops matching and Kyle re-approves.
   A clean rebase keeps it, because the grant is pinned to the CHANGES, not to the tip commit.)
EOF
  exit 1
fi

# ---- 5. A valid, unexpired, SHA-matching token → CONSUME and allow ------------------------------
TOK="$TOKENS/$KEY"
if [ -f "$TOK" ]; then
  exp="$(grep -E '^expires=' "$TOK" 2>/dev/null | head -1 | cut -d= -f2-)"
  [ -z "$exp" ] && exp="$(head -1 "$TOK" 2>/dev/null || echo 0)"   # legacy bare-epoch token
  case "$exp" in ''|*[!0-9]*) exp=0 ;; esac
  if [ "$now" -lt "$exp" ]; then
    tok_sha="$(grep -E '^sha=' "$TOK" 2>/dev/null | head -1 | cut -d= -f2-)"
    # SHA-pin: a legacy token with no sha is honoured (back-compat); otherwise the approved commit
    # must be one of the shas actually being pushed. A delete carries no moving sha, so a pinned
    # token can't silently authorize a delete of a different ref — it falls through to DENY.
    ok=0
    if [ -z "$tok_sha" ]; then ok=1
    else for s in $MOVING; do [ "$s" = "$tok_sha" ] && ok=1 && break; done; fi
    # ⭐ PIN TO THE CHANGES, NOT THE TIP. A rebase rewrites every sha, so an approval given before
    # someone else pushed stopped matching the moment we rebased onto them — approve, rebase,
    # denied, approve again. That is not a security property, it is an accounting artifact:
    # the CHANGES Kyle looked at are identical. `git patch-id` is stable across a rebase precisely
    # when the content is unchanged, so a clean rebase keeps the approval and a rebase whose
    # CONFLICT RESOLUTION altered a diff correctly stops matching and asks again.
    if [ "$ok" = 0 ]; then
      tok_pid="$(grep -E '^patch_id=' "$TOK" 2>/dev/null | head -1 | cut -d= -f2-)"
      if [ -n "$tok_pid" ]; then
        for s in $MOVING; do
          _pid="$(git show "$s" 2>/dev/null | git patch-id --stable 2>/dev/null | cut -d' ' -f1)"
          if [ -n "$_pid" ] && [ "$_pid" = "$tok_pid" ]; then ok=1; break; fi
        done
      fi
    fi
    if [ "$ok" = 1 ]; then
      rm -f "$TOK"                                   # one push per approval
      rm -f "$REQUESTS/$KEY" "$CLAIMS/$KEY" 2>/dev/null || true
      exit 0
    fi
  else
    rm -f "$TOK"                                     # expired — clear it; fall through to DENY
  fi
fi

# ---- 6. No token, but a FRESH matching claim from PreToolUse → honour once ----------------------
# This is the approved-DIRECT-push path: PreToolUse already consumed the token at the tool layer.
CLM="$CLAIMS/$KEY"
if [ -f "$CLM" ]; then
  c_sha="$(grep -E '^sha=' "$CLM" 2>/dev/null | head -1 | cut -d= -f2-)"
  c_epoch="$(grep -E '^epoch=' "$CLM" 2>/dev/null | head -1 | cut -d= -f2-)"
  case "$c_epoch" in ''|*[!0-9]*) c_epoch=0 ;; esac
  if [ "$((now - c_epoch))" -le "$CLAIM_TTL" ]; then
    for s in $MOVING; do
      if [ "$s" = "$c_sha" ]; then
        rm -f "$CLM" 2>/dev/null || true
        exit 0
      fi
    done
  fi
  rm -f "$CLM" 2>/dev/null || true                   # stale / non-matching → drop it, then DENY
fi

# ---- 7. Nothing authorizes this push → file a request and DENY ---------------------------------
HEAD_SHA="$(git rev-parse HEAD 2>/dev/null || printf '%s' "${MOVING## }")"
mkdir -p "$REQUESTS" 2>/dev/null || true
{ echo "repo=$REPO"; echo "repo_name=$NAME"; echo "cwd=$PWD"
  echo "cmd=git push $REMOTE_NAME"; echo "sha=$HEAD_SHA"; echo "epoch=$now"
  echo "created=$(date '+%Y-%m-%d %H:%M')"; } > "$REQUESTS/$KEY" 2>/dev/null || true

echo "🛑 Push to '$NAME' needs Kyle's approval. THE REQUEST IS NOW FILED — that is step 1 done." >&2
echo "" >&2
echo "   THE THREE STEPS. Every session follows these; nobody has to invent a dance." >&2
echo "     1. FINISH COMMITTING FIRST, then ATTEMPT. Being denied IS how the request reaches" >&2
echo "        Kyle — you are here. A commit made AFTER the request invalidates the approval," >&2
echo "        correctly: he approved a tip, and the tip moved. Re-attempt to re-file." >&2
echo "     2. TELL HIM ONCE, then wait: \"<repo> is filed and waiting for your tap.\"" >&2
echo "        Do NOT ask permission first. Asking before filing is what creates the loop:" >&2
echo "        he says yes, there is nothing to tap, you push, you get denied, he taps anyway." >&2
echo "     3. RE-RUN, then VERIFY it landed and say the sha. Approved is not pushed." >&2
echo "" >&2
echo "   He taps it in Conductor's inbox or on his phone. CLI: bus.sh push approve $NAME" >&2
echo "   Commits are free. Only the push is gated, and a genuine no-op never is." >&2
echo "   Your approval survives a clean rebase and is NOT spent by a rejected push." >&2
# Naming the LAYER is not decoration: a scripted or aliased push never reaches the tool-layer
# gate, so "which one caught me" is the difference between a session that understands why it was
# stopped and one that thinks the gate is flaky. Its own test asserts this phrase; I dropped it
# rewriting the message and the test caught it.
echo "   (Caught by the pre-push hook — a scripted push bypasses the tool-layer gate.)" >&2
exit 1
