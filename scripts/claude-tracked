#!/usr/bin/env bash
# claude-tracked — open Claude Code in its own Tilix window with a unique X11
# title so Conductor can focus the precise window/tab on tile click.
#
# Install:
#   sudo install -m755 scripts/claude-tracked /usr/local/bin/
#
# Usage:
#   claude-tracked <name> [--dir <path>] [claude args...]
#
# Example:
#   claude-tracked api-server --resume
#   claude-tracked api-server --dir ~/code/api --continue   # Conductor relaunch
#
# Notes:
#   - The window title becomes "claude:<name>". Conductor matches by exactly
#     this prefix in `wmctrl -lp` output.
#   - --dir <path> cd's into <path> before launching claude, so a relaunch with
#     `--continue` resolves to that folder's most-recent session. It is consumed
#     here (not passed to claude, which has no --dir flag); all other args pass
#     straight through.
#   - Falls back to gnome-terminal then xterm if tilix isn't installed.
set -euo pipefail

NAME="${1:?usage: claude-tracked <name> [--dir <path>] [claude args...]}"
shift || true

# Pull an optional `--dir <path>` out of the argument list; everything else is
# forwarded to claude verbatim.
DIR=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) DIR="${2:?--dir needs a path}"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

TITLE="claude:${NAME}"

# Run the terminal in its OWN transient systemd scope. Without this, a launch from
# Conductor's relaunch inherits conductor.service's cgroup — and when it is the first
# tilix of a desktop session, the tilix SERVER (and every terminal it later hosts)
# lives there too. On 2026-10-11 a session's eval job hit 90 GB, the kernel OOM-killed
# it as a conductor.service process, and systemd's OOMPolicy=stop then took down the
# whole unit: Conductor, the tilix server, and all ten relaunched sessions with it.
# A scope is the same process (env, DISPLAY intact), just accounted separately.
# Skipped when there is no user bus to ask (e.g. a bare tty).
SCOPE=()
if command -v systemd-run >/dev/null 2>&1 \
   && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
  SCOPE=(systemd-run --user --scope --collect --quiet
         --description="claude-tracked ${NAME}")
fi

# Build the in-terminal command: optionally cd first (quoted), then claude, then
# drop to an interactive shell so the window stays open after claude exits.
#
# claude ITSELF also starts in its own scope. The terminal-level scope above is not enough:
# tilix moves each new SHELL into a vte-spawn scope, but `bash -c` forks claude before that
# move lands, so claude (and every job it runs) stayed in the tilix SERVER's cgroup —
# conductor.service on 2026-10-11, dbus.service on 2026-10-12 (MEASURED, both with
# OOMPolicy=stop). Hand-started sessions never hit this: you type `claude` after the move.
CLAUDE_CMD="claude ${ARGS[*]:-}"
if [ ${#SCOPE[@]} -gt 0 ]; then
  CLAUDE_CMD="$(printf '%q ' "${SCOPE[@]}")-- ${CLAUDE_CMD}"
fi
CMD="${CLAUDE_CMD}"
[ -n "$DIR" ] && CMD="cd $(printf %q "$DIR") && ${CMD}"
CMD="${CMD}; exec bash"

if command -v tilix >/dev/null 2>&1; then
  # Use `-e <cmd>`, NOT `-- <cmd>`: when a tilix server is already running (the
  # common case — you have other tilix windows open), the single-instance
  # invocation SILENTLY IGNORES a `--`-style command and just opens a bare
  # shell. `-e` is honored by the running server, so claude actually launches.
  exec "${SCOPE[@]}" tilix --title "${TITLE}" -e bash -c "${CMD}"
elif command -v gnome-terminal >/dev/null 2>&1; then
  # gnome-terminal sets the title via -t; some versions ignore it once a shell
  # rewrites PS1. Best-effort.
  exec "${SCOPE[@]}" gnome-terminal --title="${TITLE}" -- bash -c "${CMD}"
elif command -v xterm >/dev/null 2>&1; then
  exec "${SCOPE[@]}" xterm -T "${TITLE}" -e bash -c "${CMD}"
else
  echo "claude-tracked: no supported terminal emulator found (tilix, gnome-terminal, xterm)" >&2
  exit 127
fi
